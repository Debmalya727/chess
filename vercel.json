{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "build": {
    "env": {
      "VITE_API_BASE_URL": "https://chess-api-hszp.onrender.com",
      "VITE_WS_URL": "wss://chess-api-hszp.onrender.com/ws"
    }
  },
  "rewrites": [
    {
      "source": "/engine/(.*)",
      "destination": "/engine/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://chess-api-hszp.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/engine/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
